# Transport backend: mqtt (default) or dbus (on-device installs only)
TRANSPORT_BACKEND=mqtt

# MCP server transport: stdio (default; Claude Code launches the process)
# or http (FastMCP streamable-http, e.g. for Synology Docker deployment).
# SERVER_TRANSPORT=http
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000
# Bearer token required by HTTP mode (leave empty to run unauthenticated on LAN)
# Generate one with: openssl rand -hex 24
# SERVER_AUTH_TOKEN=

# D-Bus configuration (only used when TRANSPORT_BACKEND=dbus)
DBUS_BUS_TYPE=system
DBUS_SERVICE_NAME=com.victronenergy

# MQTT configuration — Venus OS MQTT gateway on the Cerbo GX (LAN :1883)
MQTT_HOST=<cerbo-ip>
MQTT_PORT=1883
MQTT_PORTAL_ID=<venus-portal-id>
MQTT_CLIENT_ID=mcp-venus-os
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Mark cached readings older than this many seconds as stale
MQTT_STALE_AFTER_SECONDS=60

# Safety configuration
SAFETY_REQUIRE_CONFIRMATION=true
SAFETY_MAX_CHARGE_CURRENT=100
SAFETY_MAX_DISCHARGE_CURRENT=100
SAFETY_MIN_SOC_LIMIT=10
SAFETY_MAX_SOC_LIMIT=100
SAFETY_ALLOWED_MODES=on,off,charger_only,inverter_only,eco

# Cerbo management over SSH (tools register only when credentials are set).
# Leave both unset to disable the SSH tool group entirely.
SSH_HOST=                    # defaults to MQTT_HOST when empty
SSH_PORT=22
SSH_USER=root
SSH_KEY_PATH=                # preferred over password
SSH_PASSWORD=
SSH_TIMEOUT_S=15
# Password used by cerbo_enable_ssh when none is passed/generated
CERBO_ROOT_PASSWORD=

# Logging
LOG_LEVEL=INFO
