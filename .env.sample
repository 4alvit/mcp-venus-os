# Transport backend: mqtt (default) or dbus (on-device installs only)
TRANSPORT_BACKEND=mqtt

# D-Bus configuration (only used when TRANSPORT_BACKEND=dbus)
DBUS_BUS_TYPE=system
DBUS_SERVICE_NAME=com.victronenergy

# MQTT configuration — Venus OS MQTT gateway on the Cerbo GX (LAN :1883)
MQTT_HOST=<cerbo-ip>
MQTT_PORT=1883
MQTT_PORTAL_ID=<venus-portal-id>
MQTT_CLIENT_ID=mcp-venus-os
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Mark cached readings older than this many seconds as stale
MQTT_STALE_AFTER_SECONDS=60

# Safety configuration
SAFETY_REQUIRE_CONFIRMATION=true
SAFETY_MAX_CHARGE_CURRENT=100
SAFETY_MAX_DISCHARGE_CURRENT=100
SAFETY_MIN_SOC_LIMIT=10
SAFETY_MAX_SOC_LIMIT=100
SAFETY_ALLOWED_MODES=on,off,charger_only,inverter_only,eco

# Logging
LOG_LEVEL=INFO
