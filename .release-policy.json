{
  "validation_workflows": [
    "ci.yml",
    "docker-build.yml",
    "release-security.yml",
    "codeql.yml",
    "dependency-review.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "bash scripts/ci.sh",
    "bash scripts/ci.sh security"
  ],
  "notes": [
    "Hardware-free checks do not validate a live Venus OS device, D-Bus firmware ABI, physical sensors or in-place device upgrades.",
    "Candidate packaging applies the reviewed frozen plan to pyproject.toml, the runtime version and the owned uv.lock entry. Stable uses a separately checked final build from the accepted RC source.",
    "OCI container assets are verified and promoted with the GitHub release. Registry and PyPI deployment must use a separately reviewed promotion adapter; CI does not update latest."
  ],
  "version_file": "pyproject.toml",
  "container_assets": {
    "mcp-venus-os-container.oci.tar": "ghcr.io/4alvit/mcp-venus-os"
  },
  "mode": "release",
  "repository": "4alvit/mcp-venus-os",
  "visibility": "public",
  "single_entry_ci": true,
  "coverage": {
    "toolkit_ref": "c70d94ff9c5f47b486359fab7abc1fd3777eb2bc",
    "reports": [
      {
        "name": "python",
        "workflow": "ci.yml",
        "job": "ci",
        "path": "coverage.xml",
        "format": "cobertura",
        "required": false
      }
    ]
  },
  "release_notes": "CHANGELOG.md",
  "sign_releases": true,
  "versioning": {
    "schema": 1,
    "promotion": "final-build",
    "files": [
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "src/mcp_venus_os/__init__.py",
        "format": "python",
        "field": "__version__",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "uv.lock",
        "format": "uv-lock",
        "package": "mcp-venus-os",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "artifacts": [
      {
        "path": "*.whl",
        "format": "wheel",
        "package": "mcp-venus-os",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "mcp_venus_os-*.tar.gz",
        "format": "sdist",
        "package": "mcp-venus-os",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "mcp-venus-os-container.oci.tar",
        "format": "oci",
        "field": [
          "config",
          "Labels",
          "org.opencontainers.image.version"
        ],
        "value": "package"
      }
    ]
  }
}
